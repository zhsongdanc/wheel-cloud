<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wheel.cloud.task.mapper.TaskEventMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_task_event (
            task_id, event_type, from_status, to_status,
            operator, event_time, create_time
        ) VALUES (
            #{taskId}, #{eventType}, #{fromStatus}, #{toStatus},
            #{operator}, #{eventTime}, #{createTime}
        )
    </insert>

    <resultMap id="EventResultMap" type="com.wheel.cloud.task.entity.TaskEvent">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="eventType" column="event_type"/>
        <result property="fromStatus" column="from_status"/>
        <result property="toStatus" column="to_status"/>
        <result property="operator" column="operator"/>
        <result property="eventTime" column="event_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByTaskId" resultMap="EventResultMap">
        SELECT * FROM t_task_event WHERE task_id = #{taskId} ORDER BY id ASC
    </select>

</mapper>
