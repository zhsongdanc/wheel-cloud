<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wheel.cloud.task.mapper.TaskRetryLogMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_task_retry_log (
            task_id, session_id, retry_count, error_type, error_code,
            error_msg, stack_trace, execute_duration, start_time, end_time,
            next_retry_time, retry_strategy, create_time
        ) VALUES (
            #{taskId}, #{sessionId}, #{retryCount}, #{errorType}, #{errorCode},
            #{errorMsg}, #{stackTrace}, #{executeDuration}, #{startTime}, #{endTime},
            #{nextRetryTime}, #{retryStrategy}, #{createTime}
        )
    </insert>

    <resultMap id="RetryLogResultMap" type="com.wheel.cloud.task.entity.TaskRetryLog">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="retryCount" column="retry_count"/>
        <result property="errorType" column="error_type"/>
        <result property="errorCode" column="error_code"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="stackTrace" column="stack_trace"/>
        <result property="executeDuration" column="execute_duration"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="nextRetryTime" column="next_retry_time"/>
        <result property="retryStrategy" column="retry_strategy"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByTaskId" resultMap="RetryLogResultMap">
        SELECT * FROM t_task_retry_log WHERE task_id = #{taskId} ORDER BY id ASC
    </select>

</mapper>
